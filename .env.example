# Copie este arquivo para .env e preencha os valores
# NÃO envie o arquivo .env para o GitHub (está no .gitignore)

# Chave de autenticação da API
API_KEY=projetoamods

# Ambiente de execução
NODE_ENV=development

# Porta do servidor (opcional - padrão: 3001)
PORT=3001

# Conexão ao banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/banco_dados
# Deixe vazio localmente se usar SQLite, ou configure com banco local
DATABASE_URL=postgresql://user:password@localhost:5432/readflow_db

# Configurações do Supabase (se usar)
SUPABASE_URL=sua_url_supabase
SUPABASE_KEY=sua_chave_supabase
